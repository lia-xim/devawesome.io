---
import ArrowIcon from "../components/ArrowIcon.astro";
import JsonFormatter from "../components/JsonFormatter.astro";
import ToolDirectory from "../components/ToolDirectory.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  surface="toolbox"
  title="DevAwesome Developer Tools"
  description="Small browser-local developer tools for formatting JSON, generating UUIDs, creating SHA-256 hashes, and planning tests."
  canonicalPath="/"
>
  <section class="toolbox-hero" aria-labelledby="home-title">
    <div class="toolbox-hero-copy">
      <h1 id="home-title">Small developer tools.<br /> Right in your browser.</h1>
      <p>Format JSON, generate IDs, create hashes, and plan tests. No signup. No uploads.</p>
      <div class="toolbox-actions">
        <a class="toolbox-button" href="#tools">Browse tools <ArrowIcon /></a>
        <a class="toolbox-button toolbox-button-secondary" href="/tools/json-formatter">Open JSON formatter <ArrowIcon /></a>
      </div>
    </div>
    <div class="hero-tool-preview">
      <JsonFormatter compact />
    </div>
  </section>

  <section class="toolbox-section tool-picker" id="tools" aria-labelledby="tools-title">
    <h2 id="tools-title">Pick a tool</h2>
    <ToolDirectory />
  </section>

  <section class="trust-strip" aria-label="How the tools handle your data">
    <p>Runs in your browser</p>
    <p>No signup</p>
    <p>No analytics</p>
  </section>

  <section class="toolbox-section simple-explainer" aria-labelledby="explain-title">
    <div>
      <h2 id="explain-title">Useful first. Explained second.</h2>
      <p>Open a tool and get the result. If you want the technical details, the method and test notes are there too.</p>
    </div>
    <div class="simple-links">
      <a href="/guides/reproducible-developer-tool-tests">
        <strong>How we test tools</strong>
        <span>Read the guide</span>
        <ArrowIcon />
      </a>
      <a href="/guess-the-programming-language/">
        <strong>Guess the programming language</strong>
        <span>Take the quiz</span>
        <ArrowIcon />
      </a>
    </div>
  </section>

  <script is:inline src="/json-formatter.js" defer></script>
</BaseLayout>
