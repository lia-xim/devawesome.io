---
import PageIntro from "../components/PageIntro.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Labs" description="Public DevAwesome fixtures, runners, saved results, and reproduction steps for published field tests." schemaType="CollectionPage">
  <PageIntro number="L4" label="Reproduction bench" title="Run the material behind the verdict." intro="Each published test links the smallest useful fixture, exact runner, saved result, and limits. The fourth rig now covers the production core behind the main SEO and MCP workbenches." />

  <section class="proof-section">
    <span class="section-label">Artifact flow</span>
    <h2 data-reveal>From fixture to dated verdict.</h2>
    <div class="lab-flow" data-stagger>
      <article><small>01</small><h3>Fixture</h3><p>Small enough to inspect. Specific enough to reproduce.</p></article>
      <article><small>02</small><h3>Runner</h3><p>Versions, commands, cost boundary, and expected behavior.</p></article>
      <article><small>03</small><h3>Evidence</h3><p>Raw outputs and failure notes before interpretation.</p></article>
      <article><small>04</small><h3>Verdict</h3><p>Dated, bounded, correctable, and linked back to the rig.</p></article>
    </div>
  </section>

  <section class="editorial-section">
    <div class="editorial-side" data-reveal><span class="section-label">Bench state</span><h2>Four public rigs passed.</h2><p>The original three were captured on 22 August 2026; the workbench contract was added on 28 August 2026.</p></div>
    <div class="editorial-main" data-reveal>
      <ul class="proof-list">
        <li><strong>Astro static contract</strong><span>Production build, generated routes, index directives, registry-backed sitemap, and a custom noindex 404.</span></li>
        <li><strong>pnpm frozen lockfile</strong><span>Offline positive case plus a deliberate stale-manifest negative case in an automatically deleted temporary fixture.</span></li>
        <li><strong>SHA-256 evidence receipt</strong><span>Known vectors, normalized line endings, Unicode input, and Node/Web Crypto equivalence for the browser-facing core.</span></li>
        <li><strong>SEO and MCP workbench core</strong><span>Conflict-safe keyword mapping, recipe preflights, crawl plans, batch indexability, run verification, MCP payload correction, and session pairing.</span></li>
      </ul>
      <div class="action-row">
        <a class="action action-dark" href="/field-tests">Read all field tests <span class="action-arrow" aria-hidden="true">→</span></a>
        <a class="action action-signal" href="/tools/evidence-receipt">Create an evidence receipt <span class="action-arrow" aria-hidden="true">→</span></a>
        <a class="action action-signal" href="/tools/developer-tool-test-plan">Build a test plan <span class="action-arrow" aria-hidden="true">→</span></a>
        <a class="action" href={site.githubUrl}>View the public source <span class="action-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
