---
import PageIntro from "../components/PageIntro.astro";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Labs" description="Public DevAwesome fixtures, runners, saved results, and reproduction steps for published field tests.">
  <PageIntro number="L2" label="Reproduction bench" title="Run the material behind the verdict." intro="Each published test links the smallest useful fixture, exact runner, saved result, and limits. The first two rigs use the production repository and an isolated temporary dependency fixture." />

  <section class="proof-section">
    <span class="section-label">Artifact flow</span>
    <h2 data-reveal>From fixture to dated verdict.</h2>
    <div class="lab-flow" data-stagger>
      <article><small>01</small><h3>Fixture</h3><p>Small enough to inspect. Specific enough to reproduce.</p></article>
      <article><small>02</small><h3>Runner</h3><p>Versions, commands, cost boundary, and expected behavior.</p></article>
      <article><small>03</small><h3>Evidence</h3><p>Raw outputs and failure notes before interpretation.</p></article>
      <article><small>04</small><h3>Verdict</h3><p>Dated, bounded, correctable, and linked back to the rig.</p></article>
    </div>
  </section>

  <section class="editorial-section">
    <div class="editorial-side" data-reveal><span class="section-label">Bench state</span><h2>Two public rigs passed.</h2><p>Both were run on 22 August 2026 and remain bounded to their declared environment.</p></div>
    <div class="editorial-main" data-reveal>
      <ul class="proof-list">
        <li><strong>Astro static contract</strong><span>Production build, generated routes, canonical sitemap set, custom 404, and excluded redirect/error aliases.</span></li>
        <li><strong>pnpm frozen lockfile</strong><span>Offline positive case plus a deliberate stale-manifest negative case in an automatically deleted temporary fixture.</span></li>
      </ul>
      <div class="action-row">
        <a class="action action-dark" href="/field-tests">Read both field tests <span class="action-arrow" aria-hidden="true">→</span></a>
        <a class="action" href={site.githubUrl}>View the public source <span class="action-arrow" aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
