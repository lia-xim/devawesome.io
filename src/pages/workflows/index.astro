---
import WorkflowDirectory from "../../components/WorkflowDirectory.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { workflows } from "../../data/workflows";

const workflowList = {
  "@type": "ItemList",
  itemListElement: workflows.map((workflow, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: workflow.name,
    url: new URL(workflow.path, "https://devawesome.io").href,
  })),
};
---

<BaseLayout
  title="Browser-Based SEO Data Workflows"
  description="Complete browser-based workflows for cleaning keyword imports, preparing crawl lists, debugging indexability, and validating MCP messages."
  canonicalPath="/workflows"
  schemaType="CollectionPage"
  schemaMainEntity={workflowList}
>
  <header class="workflow-hub-header">
    <div>
      <a href="/">← Home</a>
      <h1>Browser-based SEO data workflows that finish the job.</h1>
    </div>
    <p>A workflow connects source input, checks, edge cases, and export. Use one when cleaning a keyword import, building a crawl list, debugging page indexability, or validating an MCP message.</p>
  </header>
  <section class="workflow-hub-list" aria-labelledby="workflow-hub-title">
    <h2 id="workflow-hub-title">Choose the SEO or developer job you need to finish</h2>
    <WorkflowDirectory />
  </section>
  <section class="workflow-principles" aria-label="Workflow principles">
    <div><strong>Local input</strong><p>The workflow does not send pasted data to a server.</p></div>
    <div><strong>Visible decisions</strong><p>You can see what changed and which choices remain yours.</p></div>
    <div><strong>Portable output</strong><p>The result can be copied or downloaded before any optional handoff.</p></div>
  </section>
</BaseLayout>
