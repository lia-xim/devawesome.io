---
import ArrowIcon from "../../components/ArrowIcon.astro";
import CrawlListWorkbench from "../../components/CrawlListWorkbench.astro";
import WorkflowHandoff from "../../components/WorkflowHandoff.astro";
import WorkflowProgress from "../../components/WorkflowProgress.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Workflows", path: "/workflows" },
  { name: "Build a clean crawl list", path: "/workflows/build-clean-crawl-list" },
];
const howTo = {
  "@type": "HowTo",
  name: "Build a clean crawl list",
  step: ["Extract URLs", "Choose normalization rules", "Review hosts and exceptions", "Export the crawl list"].map((name) => ({ "@type": "HowToStep", name })),
};
---

<BaseLayout title="Build a Clean Crawl List" description="Normalize a mixed URL list, inspect invalid entries, and export a stable crawl-ready file locally." canonicalPath="/workflows/build-clean-crawl-list" schemaMainEntity={howTo} breadcrumbs={breadcrumbs}>
  <header class="workflow-page-header">
    <a href="/workflows">← All workflows</a>
    <h1>Build a clean crawl list</h1>
    <p>Normalize copied URLs, expose invalid entries, and export one stable list before a crawler touches it.</p>
    <WorkflowProgress steps={["Extract URLs", "Choose rules", "Review exceptions", "Export the list"]} />
  </header>

  <section class="workflow-tool-surface" aria-label="Crawl list workbench">
    <div class="workflow-local-note"><strong>No crawl.</strong><span>The browser parses your text without requesting any URL.</span></div>
    <CrawlListWorkbench />
  </section>

  <section class="workflow-scenario-list" aria-labelledby="crawl-scenarios-title"><h2 id="crawl-scenarios-title">Use this workflow when…</h2><ul><li>A crawl export contains the same page in several URL forms.</li><li>You copied URLs from a spreadsheet, sitemap, Markdown file, or issue.</li><li>You need to separate invalid text before a crawl or import.</li></ul></section>

  <section class="workflow-explanation" aria-labelledby="crawl-changes-title">
    <div class="workflow-section-heading"><h2 id="crawl-changes-title">What changes, exactly?</h2><p>Every normalization choice is visible. The workflow cannot decide whether two parameter variants contain different content.</p></div>
    <div class="workflow-comparison">
      <div><span>Before</span><pre>https://EXAMPLE.com/
https://example.com
example.com/page/#top
example.com/page?utm_source=news
example.com/about/</pre></div>
      <dl><div><dt>Unique URLs</dt><dd>3</dd></div><div><dt>Duplicates</dt><dd>2</dd></div><div><dt>Invalid</dt><dd>0</dd></div></dl>
      <div class="is-result"><span>After</span><pre>https://example.com/
https://example.com/page
https://example.com/about</pre></div>
    </div>
    <p class="workflow-boundary">A normalized URL is not proof that the page exists, returns 200, redirects correctly, or should be canonical. Those checks require a live request.</p>
  </section>

  <section class="edge-case-section" aria-labelledby="crawl-edge-title">
    <div class="workflow-section-heading"><h2 id="crawl-edge-title">Check these edge cases</h2><p>Do not remove information simply because it looks untidy.</p></div>
    <div class="edge-case-table" role="table" aria-label="URL normalization edge cases">
      <div role="row"><strong role="columnheader">Edge case</strong><strong role="columnheader">Input</strong><strong role="columnheader">Decision</strong></div>
      <div role="row"><span role="cell">Content parameter</span><code role="cell">?page=2</code><code role="cell">Keep unless proven redundant</code></div>
      <div role="row"><span role="cell">Tracking parameter</span><code role="cell">?utm_source=email</code><code role="cell">Remove in tracking mode</code></div>
      <div role="row"><span role="cell">Fragment</span><code role="cell">/guide#setup</code><code role="cell">Remove for an HTTP crawl target</code></div>
      <div role="row"><span role="cell">Bare domain</span><code role="cell">example.com</code><code role="cell">Add HTTPS only when intended</code></div>
    </div>
  </section>

  <WorkflowHandoff title="Check one URL live" description="AnalyseSpider requests one public URL and reports the response, directives, links, and page signals it receives." href="https://analysespider.com/" cta="Open AnalyseSpider" disclosure="DevAwesome and AnalyseSpider are operated by Matthias Ramahi. This is a related workflow handoff, not an independent recommendation." />

  <WorkflowHandoff title="Run the complete list as a site audit" description="Contextter Site Audit is the next step when the reviewed list belongs to a larger crawl, prioritization, and monitoring workflow." href="https://contextter.com/features/site-audit" cta="Open Contextter Site Audit" disclosure="DevAwesome and Contextter are operated by Matthias Ramahi. This is a related workflow handoff, not an independent recommendation." />

  <section class="workflow-related" aria-labelledby="crawl-related-title"><div><h2 id="crawl-related-title">Related tools and guide</h2><p>Use the cleaned list as the input for the next distinct check.</p></div><div><a href="/guides/prepare-crawl-list"><strong>Crawl-list guide</strong><span>Understand safe normalization, ambiguous variants, and the live-check boundary.</span><ArrowIcon /></a><a href="/tools/robots-txt-tester"><strong>Robots.txt tester</strong><span>Test a crawler and path against pasted rules.</span><ArrowIcon /></a><a href="/workflows/debug-indexability"><strong>Debug indexability</strong><span>Combine the signals for one page.</span><ArrowIcon /></a></div></section>
  <script is:inline type="module" src="/crawl-list-workbench.js"></script>
</BaseLayout>
