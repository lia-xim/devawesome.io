---
import JsonFormatter from "../../components/JsonFormatter.astro";
import ToolPageContent from "../../components/ToolPageContent.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const toolSchema = {
  "@type": "WebApplication",
  name: "DevAwesome JSON Formatter",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript.",
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="JSON Formatter"
  description="Format, validate, and minify JSON, API payloads, and SEO export data locally in your browser without uploading it."
  canonicalPath="/tools/json-formatter"
  schemaMainEntity={toolSchema}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/tools">← All tools</a>
      <h1>JSON formatter</h1>
    </div>
    <p>Paste JSON from an API, SEO export, or MCP payload. Spot syntax errors and copy a readable or minified result.</p>
  </header>

  <section class="tool-surface">
    <div class="tool-privacy-note">
      <span><strong>No uploads.</strong> Input is processed only in your browser.</span>
      <span>Maximum input: 1,000,000 characters</span>
    </div>
    <JsonFormatter />
  </section>

  <ToolPageContent
    steps={[
      "Paste a complete JSON value into the input pane.",
      "Choose Format JSON for a two-space layout or Minify for a compact representation.",
      "Read any syntax error, check the output, and copy the result.",
    ]}
    handles={[
      "JSON objects, arrays, strings, numbers, booleans, and null",
      "Readable two-space formatting",
      "Whitespace removal through parsing and serialization",
      "API payloads, SEO export fragments, and JSON-RPC envelopes",
    ]}
    limits={[
      "It checks JSON syntax, not a product-specific schema or business rule.",
      "Formatting cannot restore comments because JSON does not include comments.",
      "The page accepts up to 1,000,000 characters and does not upload the input.",
    ]}
    sources={[
      { label: "RFC 8259: The JavaScript Object Notation Data Interchange Format", href: "https://www.rfc-editor.org/rfc/rfc8259.html", note: "Defines JSON grammar and interoperability rules." },
      { label: "ECMAScript JSON object specification", href: "https://tc39.es/ecma262/multipage/structured-data.html", note: "Defines the browser's JSON.parse and JSON.stringify behavior." },
    ]}
    related={[
      { label: "Keyword list cleaner", href: "/tools/keyword-list-cleaner", note: "Prepare a flat list before import." },
      { label: "SHA-256 hash", href: "/tools/evidence-receipt", note: "Create a digest after the final text is stable." },
    ]}
  />

  <script is:inline src="/json-formatter.js" defer></script>
</BaseLayout>
