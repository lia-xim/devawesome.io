---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolPageContent from "../../components/ToolPageContent.astro";
import WorkflowLink from "../../components/WorkflowLink.astro";

const toolSchema = {
  "@type": "WebApplication",
  name: "Simple Test Case Builder",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript for local plan generation and export.",
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="Simple Test Case Builder"
  description="Turn one action, expected result, and edge case into a short Markdown test case locally in your browser."
  canonicalPath="/tools/developer-tool-test-plan"
  schemaMainEntity={toolSchema}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/tools">← All tools</a>
      <h1>Simple test case builder</h1>
    </div>
    <p>Describe one action and the result you expect. Get a short Markdown test case you can paste into an issue or QA note.</p>
  </header>

  <section class="tool-surface">
    <div class="tool-privacy-note">
      <span><strong>No uploads or storage.</strong> Your entries stay in this browser tab.</span>
      <span>Plain Markdown output</span>
    </div>
    <div class="plan-builder toolbox-plan-builder" data-plan-builder>
      <form class="plan-form" data-plan-form>
        <div class="form-heading">
          <h2>Plan the test</h2>
          <p>Keep it to one behavior. A short test you can run is more useful than a complete-looking form.</p>
        </div>

        <div class="form-grid">
          <label><span>What are you testing? <b>Required</b></span><input name="subject" required maxlength="140" placeholder="Canonical redirect for /old-page" /></label>
          <label><span>Action or input <b>Required</b></span><textarea name="action" required rows="4" placeholder="Request /old-page without following redirects"></textarea></label>
          <label><span>Expected result <b>Required</b></span><textarea name="expected" required rows="4" placeholder="Returns 301 and preserves the path"></textarea></label>
          <label><span>Important edge case</span><textarea name="edge" rows="4" placeholder="Query strings remain intact"></textarea></label>
        </div>

        <div class="plan-actions">
          <button class="toolbox-button" type="submit">Build test case</button>
          <button class="tool-action-secondary" type="reset">Clear</button>
        </div>
      </form>

      <aside class="plan-output" aria-labelledby="plan-output-title">
        <div class="output-heading">
          <h2 id="plan-output-title">Test case</h2>
          <p data-plan-status aria-live="polite">Complete the three required fields.</p>
        </div>
        <pre><code tabindex="0" data-plan-output>&#123;
Write the subject, action, and expected result.</code></pre>
        <div class="plan-actions">
          <button class="tool-action-secondary" type="button" data-copy disabled>Copy Markdown</button>
          <button class="tool-action-secondary" type="button" data-download disabled>Download .md</button>
        </div>
      </aside>
    </div>
    <noscript><p class="noscript-note">This tool needs JavaScript to create and export the JSON file.</p></noscript>
  </section>

  <ToolPageContent
    steps={[
      "Name one behavior, route, API call, or tool action.",
      "Write the action and the exact observable result that counts as a pass.",
      "Add one edge case if it matters, then copy the Markdown into your issue or QA notes.",
    ]}
    handles={[
      "One compact happy-path test case",
      "An optional edge or failure condition",
      "Markdown output for issues, pull requests, and QA notes",
    ]}
    limits={[
      "It does not run the test or decide whether a result passed.",
      "It does not capture versions, environments, fixtures, or evidence for you.",
      "Use the longer reproducibility guide when a result will be published as evidence.",
    ]}
    sources={[
      { label: "DevAwesome reproducible testing guide", href: "/guides/reproducible-developer-tool-tests", note: "The fuller method for tests that need published evidence." },
      { label: "DevAwesome methodology", href: "/methodology", note: "Editorial and review boundaries for public field tests." },
    ]}
    related={[
      { label: "URL list normalizer", href: "/tools/url-list-normalizer", note: "Prepare a clean set of technical SEO test targets." },
      { label: "JSON formatter", href: "/tools/json-formatter", note: "Inspect an API or structured-data result." },
    ]}
  />

  <WorkflowLink
    title="Testing a complete website?"
    description="Contextter Site Audit crawls a project and keeps technical issues in an ongoing SEO workflow."
    href="https://contextter.com/features/site-audit"
    cta="Run a full crawl in Contextter"
  />

  <script is:inline src="/test-plan.js" defer></script>
</BaseLayout>
