---
import ToolDirectory from "../../components/ToolDirectory.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tools } from "../../data/tools";

const toolList = {
  "@type": "ItemList",
  itemListElement: tools.map((tool, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: tool.name,
    url: new URL(tool.path, "https://devawesome.io").href,
  })),
};
---

<BaseLayout
  title="Free Browser-Based SEO and Developer Tools"
  description="Use free browser-based tools to clean keyword and URL lists, test robots.txt rules, preview SERP snippets, format JSON, and generate UUIDs or SHA-256 hashes."
  canonicalPath="/tools"
  schemaType="CollectionPage"
  schemaMainEntity={toolList}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/">← Home</a>
      <h1>Free browser-based SEO and developer tools</h1>
    </div>
    <p>Clean keyword and URL lists, test robots.txt rules, preview SERP snippets, validate MCP or JSON payloads, and generate UUIDs or hashes. Each tool runs in your browser and keeps inputs out of server requests.</p>
  </header>

  <section class="toolbox-section tool-picker" aria-labelledby="all-tools-title">
    <h2 id="all-tools-title">Choose an SEO or developer tool</h2>
    <ToolDirectory />
  </section>

  <section class="tool-detail">
    <div class="tool-detail-heading">
      <h2>Inputs stay in your browser.</h2>
      <p>The tools run in your browser. DevAwesome does not send inputs to an API or store them in browser storage.</p>
    </div>
    <div class="tool-detail-links">
      <a href="/datenschutz"><span>Read the privacy details</span><span aria-hidden="true">→</span></a>
      <a href="/guides/reproducible-developer-tool-tests"><span>See how tools are tested</span><span aria-hidden="true">→</span></a>
      <a href="/workflows"><span>Use a complete workflow</span><span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="tool-detail" aria-labelledby="practice-title">
    <div class="tool-detail-heading" data-reveal>
      <span class="section-label">Practice</span>
      <h2 id="practice-title">Read code. Spot the syntax clue.</h2>
      <p>This is a short learning exercise, not a data utility. Identify eight programming languages from original samples and inspect the explanation behind every answer.</p>
    </div>
    <div class="tool-detail-links" data-reveal>
      <a href="/guess-the-programming-language/"><span>Try the programming-language quiz</span><span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
