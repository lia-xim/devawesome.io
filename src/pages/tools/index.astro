---
import ToolDirectory from "../../components/ToolDirectory.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { tools } from "../../data/tools";

const toolList = {
  "@type": "ItemList",
  itemListElement: tools.map((tool, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: tool.name,
    url: new URL(tool.path, "https://devawesome.io").href,
  })),
};
---

<BaseLayout
  title="Developer and SEO Mini Tools"
  description="Free browser-local mini tools for keyword lists, URL sets, JSON, UUIDs, SHA-256 hashes, and simple test cases."
  canonicalPath="/tools"
  schemaType="CollectionPage"
  schemaMainEntity={toolList}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/">← Home</a>
      <h1>Developer and SEO tools</h1>
    </div>
    <p>One page, one job. Clean an input, generate a result, and leave with a file you can use. No signup, analytics, or uploads.</p>
  </header>

  <section class="toolbox-section tool-picker" aria-labelledby="all-tools-title">
    <h2 id="all-tools-title">Browse by category</h2>
    <ToolDirectory />
  </section>

  <section class="tool-detail">
    <div class="tool-detail-heading">
      <h2>Local by design.</h2>
      <p>The tools run in your browser. DevAwesome does not send inputs to an API or store them in browser storage.</p>
    </div>
    <div class="tool-detail-links">
      <a href="/datenschutz"><span>Read the privacy details</span><span aria-hidden="true">→</span></a>
      <a href="/guides/reproducible-developer-tool-tests"><span>See how tools are tested</span><span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
