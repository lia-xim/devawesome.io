---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolPageContent from "../../components/ToolPageContent.astro";

const toolSchema = {
  "@type": "WebApplication",
  name: "DevAwesome SHA-256 Hash Generator",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript, Web Crypto, and a secure browser context.",
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="SHA-256 Hash Generator"
  description="Create a SHA-256 hash from text locally in your browser without uploading it."
  canonicalPath="/tools/evidence-receipt"
  schemaMainEntity={toolSchema}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/tools">← All tools</a>
      <h1>SHA-256 hash</h1>
    </div>
    <p>Create a SHA-256 hash from text. Copy the digest or download a small JSON receipt.</p>
  </header>

  <section class="tool-surface">
    <div class="tool-privacy-note">
      <span><strong>No uploads.</strong> Text is processed only in your browser.</span>
      <a href="/schemas/evidence-receipt.v0.1.json">Receipt schema</a>
    </div>
    <div class="hash-workbench" data-receipt-builder>
      <form class="hash-input" data-receipt-form>
        <h2>Text to hash</h2>
        <p>Line endings are normalized to LF before hashing.</p>
        <label class="tool-field">
          <span>Text</span>
          <textarea name="evidence" required rows="12" maxlength="1000000" placeholder="Paste text here"></textarea>
        </label>
        <div class="tool-actions">
          <button class="toolbox-button" type="submit">Create hash</button>
          <button class="tool-action-secondary" type="reset">Clear</button>
        </div>
      </form>
      <div class="hash-output">
        <h2>Result</h2>
        <p class="tool-status" data-receipt-status aria-live="polite">Paste text to create a hash.</p>
        <label class="tool-field">
          <span>SHA-256 digest</span>
          <input readonly spellcheck="false" data-receipt-digest placeholder="64-character digest" />
        </label>
        <div class="tool-actions">
          <button class="tool-action-secondary" type="button" data-receipt-copy-hash disabled>Copy hash</button>
        </div>
        <details class="receipt-details">
          <summary>Portable JSON receipt</summary>
          <pre><code tabindex="0" data-receipt-output>The receipt will appear here.</code></pre>
          <div class="tool-actions">
            <button class="tool-action-secondary" type="button" data-receipt-copy disabled>Copy JSON</button>
            <button class="tool-action-secondary" type="button" data-receipt-download disabled>Download .json</button>
          </div>
        </details>
      </div>
    </div>
    <noscript><p class="noscript-note">This tool requires JavaScript and Web Crypto. No fallback sends your text to a server.</p></noscript>
  </section>

  <ToolPageContent
    steps={[
      "Paste the exact text you want to fingerprint.",
      "Create the SHA-256 digest. Windows and classic Mac line endings are normalized to LF first.",
      "Copy the 64-character hexadecimal hash. Open the JSON receipt only if you need the byte count and normalization note.",
    ]}
    handles={[
      "UTF-8 text up to 1,000,000 characters",
      "SHA-256 through the browser's Web Crypto implementation",
      "CRLF and CR line-ending normalization before hashing",
      "A portable JSON receipt as an optional secondary output",
    ]}
    limits={[
      "A matching hash supports a content-equivalence check; it does not prove authorship, ownership, or creation time.",
      "The tool hashes text, not uploaded files.",
      "Text hashed elsewhere must use the same UTF-8 encoding and line-ending normalization to match.",
    ]}
    sources={[
      { label: "NIST FIPS 180-4: Secure Hash Standard", href: "https://csrc.nist.gov/pubs/fips/180-4/upd1/final", note: "Specification for the SHA-2 family, including SHA-256." },
      { label: "Web Cryptography API Level 2", href: "https://w3c.github.io/webcrypto/#SubtleCrypto-method-digest", note: "Defines the browser digest operation used here." },
    ]}
    related={[
      { label: "Executable SHA-256 field test", href: "/field-tests/evidence-receipt-contract", note: "Inspect the known vectors and implementation comparison." },
      { label: "JSON formatter", href: "/tools/json-formatter", note: "Format the optional receipt or another payload." },
    ]}
  />

  <script is:inline type="module" src="/evidence-receipt.js"></script>
</BaseLayout>
