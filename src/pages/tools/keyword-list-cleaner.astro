---
import KeywordListCleaner from "../../components/KeywordListCleaner.astro";
import ToolPageContent from "../../components/ToolPageContent.astro";
import WorkflowLink from "../../components/WorkflowLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const toolSchema = {
  "@type": "WebApplication",
  name: "DevAwesome Keyword List Cleaner",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any",
  browserRequirements: "Requires JavaScript.",
  isAccessibleForFree: true,
};
---

<BaseLayout
  title="Keyword List Cleaner"
  description="Clean messy keyword lists, remove duplicates, and export lines, CSV, or JSON without uploading your data."
  canonicalPath="/tools/keyword-list-cleaner"
  schemaMainEntity={toolSchema}
>
  <header class="tool-page-header">
    <div>
      <a class="tool-page-back" href="/tools">← All tools</a>
      <h1>Keyword list cleaner</h1>
    </div>
    <p>Paste a clean export or a messy list. Remove duplicate entries and list noise, then choose whether the result should use lines, commas, or JSON.</p>
  </header>

  <section class="tool-surface">
    <div class="tool-privacy-note">
      <span><strong>No uploads.</strong> The list is processed only in this browser tab.</span>
      <span>Lines, commas, tabs, semicolons, and pipes accepted</span>
    </div>
    <KeywordListCleaner />
  </section>

  <ToolPageContent
    steps={[
      "Paste the list. Auto mode understands common separators and removes ordinary bullets or list numbers.",
      "Choose how duplicates and whitespace should be handled, then select Lines, Commas, or JSON for the result.",
      "Copy the result or download it in the matching TXT, CSV, or JSON format.",
    ]}
    handles={[
      "Blank rows, repeated spaces, bullets, list numbers, and separator-only rows",
      "Duplicate entries while keeping the first spelling and the original order",
      "Line, comma, tab, semicolon, pipe, and spaced-slash separators",
      "Quoted comma-separated values and three selectable output formats",
    ]}
    limits={[
      "It does not measure search volume, intent, difficulty, or rankings.",
      "Auto mode treats common separators as list boundaries. Choose Lines if punctuation belongs inside a keyword.",
      "It does not upload, save, or import the result into another product.",
    ]}
    intro="The example is deliberately messy. Change the separator and output controls to see exactly what will be removed and how the final list will be written."
    handlesTitle="What gets cleaned"
    limitsTitle="What stays your decision"
    sourcesIntro="CSV quoting follows RFC 4180. The extra list cleanup is a documented DevAwesome convenience, not part of that standard."
    relatedIntro="Use another cleaner when the next input is a URL set or structured JSON."
    sources={[
      { label: "RFC 4180: Common Format and MIME Type for CSV Files", href: "https://www.rfc-editor.org/info/rfc4180/", note: "Reference for quoted and comma-separated CSV fields." },
    ]}
    related={[
      { label: "URL list normalizer", href: "/tools/url-list-normalizer", note: "Prepare the crawl targets behind a keyword set." },
      { label: "JSON formatter", href: "/tools/json-formatter", note: "Inspect structured export or API data." },
    ]}
  />

  <WorkflowLink
    title="Prepare the complete keyword import"
    description="Review realistic before-and-after examples, edge cases, export choices, and the optional next step after cleanup."
    href="/workflows/prepare-keyword-import"
    cta="Open the keyword workflow"
    internal
  />

  <script is:inline src="/keyword-list-cleaner.js" defer></script>
</BaseLayout>
