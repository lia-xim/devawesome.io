---
interface LinkItem {
  label: string;
  href: string;
  note?: string;
}

interface Props {
  steps: string[];
  handles: string[];
  limits: string[];
  sources: LinkItem[];
  related?: LinkItem[];
  intro?: string;
  handlesTitle?: string;
  limitsTitle?: string;
  sourcesIntro?: string;
  relatedIntro?: string;
}

const {
  steps,
  handles,
  limits,
  sources,
  related = [],
  intro = "Use the example first, then replace it with your own input. Check the result before you copy or download it.",
  handlesTitle = "What the tool changes",
  limitsTitle = "What to check yourself",
  sourcesIntro = "These are the specifications used for the tool's rules and terminology.",
  relatedIntro = "A useful next step, if your job is not finished yet.",
} = Astro.props;
---

<section class="tool-copy-section" aria-labelledby="how-to-use-title">
  <div class="tool-copy-heading">
    <h2 id="how-to-use-title">How it works</h2>
    <p>{intro}</p>
  </div>
  <ol class="tool-step-list">
    {steps.map((step, index) => (
      <li><span>{String(index + 1).padStart(2, "0")}</span><p>{step}</p></li>
    ))}
  </ol>
</section>

<section class="tool-copy-band" aria-label="Capabilities and limits">
  <div>
    <h2>{handlesTitle}</h2>
    <ul>{handles.map((item) => <li>{item}</li>)}</ul>
  </div>
  <div>
    <h2>{limitsTitle}</h2>
    <ul>{limits.map((item) => <li>{item}</li>)}</ul>
  </div>
</section>

<section class="tool-reference-section" aria-labelledby="references-title">
  <div>
    <h2 id="references-title">Technical reference</h2>
    <p>{sourcesIntro}</p>
  </div>
  <div class="tool-reference-links">
    {sources.map((source) => (
      <a href={source.href}>
        <strong>{source.label}</strong>
        {source.note && <span>{source.note}</span>}
        <b aria-hidden="true">↗</b>
      </a>
    ))}
  </div>
</section>

{related.length > 0 && (
  <section class="related-tools" aria-labelledby="related-tools-title">
    <div>
      <h2 id="related-tools-title">Related tools</h2>
      <p>{relatedIntro}</p>
    </div>
    <div class="related-tool-links">
      {related.map((item) => (
        <a href={item.href}><strong>{item.label}</strong>{item.note && <span>{item.note}</span>}<b aria-hidden="true">→</b></a>
      ))}
    </div>
  </section>
)}
