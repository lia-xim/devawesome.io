---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const sample = "1. technical seo audit, keyword clustering\n2) Technical SEO Audit | search intent\n/\nkeyword clustering";
---

<div class:list={["list-workbench", compact && "list-workbench-compact"]} data-keyword-cleaner>
  <div class="workbench-bar">
    <strong>Keyword list cleaner</strong>
    <div>
      <button type="button" data-keyword-clear>Clear</button>
      <button type="button" data-keyword-copy disabled>Copy</button>
      {!compact && <button type="button" data-keyword-download disabled>Download</button>}
    </div>
  </div>
  <div class="list-panes">
    <label>
      <span>Paste keywords</span>
      <textarea rows={compact ? 8 : 14} maxlength="1000000" spellcheck="false" data-keyword-input>{sample}</textarea>
    </label>
    <label>
      <span>Clean list</span>
      <textarea rows={compact ? 8 : 14} readonly spellcheck="false" data-keyword-output></textarea>
    </label>
  </div>
  {compact ? (
    <div class="list-options list-options-simple">
      <p data-keyword-status aria-live="polite">Ready</p>
      <button class="toolbox-button toolbox-button-small" type="button" data-keyword-clean>Clean list</button>
    </div>
  ) : (
    <div class="list-control-panel">
      <div class="list-control-grid list-control-grid-three">
        <label class="list-select-field">
          <span>Read the input as</span>
          <select data-keyword-input-mode>
            <option value="smart">Auto-detect separators</option>
            <option value="lines">One keyword per line</option>
            <option value="comma">Comma-separated values</option>
          </select>
          <small>Auto detects lines, commas, tabs, semicolons, pipes, and spaced slashes.</small>
        </label>
        <fieldset class="format-picker">
          <legend>Output format</legend>
          <div>
            <label><input type="radio" name="keyword-output-format" value="lines" checked data-keyword-format /><span>Lines</span></label>
            <label><input type="radio" name="keyword-output-format" value="comma" data-keyword-format /><span>Commas</span></label>
            <label><input type="radio" name="keyword-output-format" value="json" data-keyword-format /><span>JSON</span></label>
          </div>
        </fieldset>
        <label class="list-select-field">
          <span>When duplicates match</span>
          <select data-keyword-duplicate-strategy>
            <option value="first">Keep the first spelling</option>
            <option value="last">Keep the last spelling</option>
            <option value="all">Keep every variant</option>
          </select>
          <small>The duplicate review below always shows what matched, including capitalization differences.</small>
        </label>
      </div>
      <div class="cleanup-options">
        <label><input type="checkbox" checked data-keyword-ignore-case /> Remove duplicates regardless of capitalization</label>
        <label><input type="checkbox" checked data-keyword-strip-noise /> Remove bullets, list numbers, and separator-only rows</label>
        <label><input type="checkbox" checked data-keyword-whitespace /> Collapse repeated spaces</label>
      </div>
      <div class="list-action-row">
        <p data-keyword-status aria-live="polite">Ready</p>
        <button class="toolbox-button toolbox-button-small" type="button" data-keyword-clean>Clean list</button>
      </div>
      <details class="review-list" data-keyword-duplicate-wrap hidden>
        <summary data-keyword-duplicate-summary>Duplicate review</summary>
        <ul data-keyword-duplicates></ul>
      </details>
    </div>
  )}
</div>
