---
interface Props {
  steps: string[];
}

const { steps } = Astro.props;
---

<ol class:list={["workflow-progress", `workflow-progress-${steps.length}`]} aria-label="Workflow steps">
  {steps.map((step, index) => (
    <li class={index === 0 ? "is-active" : undefined}>
      <span>{index + 1}</span>
      <strong>{step}</strong>
    </li>
  ))}
</ol>
