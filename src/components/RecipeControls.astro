---
interface Props {
  label?: string;
}

const { label = "Recipe" } = Astro.props;
---

<div class="recipe-controls">
  <div>
    <strong>{label}</strong>
    <span>Save or reload the rules. Input and output are never included.</span>
  </div>
  <div>
    <button type="button" data-recipe-save>Download recipe</button>
    <label class="recipe-load">Load recipe<input type="file" accept="application/json,.json" data-recipe-load /></label>
  </div>
  <dialog class="recipe-preflight" data-recipe-preflight>
    <div>
      <span>Recipe preflight</span>
      <h3>Review the saved mappings</h3>
      <p data-recipe-preflight-summary></p>
      <ul data-recipe-preflight-list></ul>
      <div><button type="button" data-recipe-preflight-cancel>Cancel</button><button type="button" data-recipe-preflight-apply>Apply recipe</button></div>
    </div>
  </dialog>
</div>
