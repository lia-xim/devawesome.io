---
interface Props {
  title: string;
  description: string;
  href: string;
  cta: string;
  disclosure?: string;
  internal?: boolean;
}

const { title, description, href, cta, internal = false, disclosure = internal ? "" : "DevAwesome, AnalyseSpider, AI-Fanout, and Crawl Foundry are operated by Matthias Ramahi. This link connects related workflow steps and is not an independent recommendation." } = Astro.props;
---

<aside class="workflow-link" aria-label={`Next workflow step: ${title}`}>
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
  </div>
  <a href={href}>{cta}<span aria-hidden="true">{internal ? "→" : "↗"}</span></a>
  {disclosure && <p class="ownership-disclosure">{disclosure}</p>}
</aside>
