---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";
import "../styles/modern.css";

type SchemaType = "WebPage" | "CollectionPage" | "TechArticle";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeCanonical?: boolean;
  language?: string;
  schemaType?: SchemaType;
  schemaMainEntity?: Record<string, unknown>;
  datePublished?: string;
  dateModified?: string;
}

const {
  title = site.title,
  description = site.description,
  canonicalPath,
  includeCanonical = true,
  language = site.language,
  schemaType = "WebPage",
  schemaMainEntity,
  datePublished,
  dateModified,
} = Astro.props;
const pageTitle = title === site.title ? title : title + " | " + site.title;
const requestedCanonicalPath = canonicalPath ?? Astro.url.pathname;
const normalizedCanonicalPath = canonicalPath || requestedCanonicalPath === "/"
  ? requestedCanonicalPath
  : requestedCanonicalPath.replace(/\/$/, "");
const canonicalUrl = new URL(normalizedCanonicalPath, site.canonicalHost);
const operatorId = site.canonicalHost + "/#operator";
const websiteId = site.canonicalHost + "/#website";
const pageNode: Record<string, unknown> = {
  "@type": schemaType,
  "@id": canonicalUrl.href + "#webpage",
  url: canonicalUrl.href,
  name: pageTitle,
  description,
  inLanguage: language,
  isPartOf: { "@id": websiteId },
  publisher: { "@id": operatorId },
};
if (schemaMainEntity) pageNode.mainEntity = schemaMainEntity;
if (schemaType === "TechArticle") {
  pageNode.headline = title;
  pageNode.author = { "@id": operatorId };
  pageNode.editor = { "@id": operatorId };
  pageNode.datePublished = datePublished;
  pageNode.dateModified = dateModified ?? datePublished;
}
const schemaGraph: Record<string, unknown>[] = [
  { "@type": "Person", "@id": operatorId, name: site.operator.name },
];
if (Astro.url.pathname === "/") {
  schemaGraph.push({
    "@type": "WebSite",
    "@id": websiteId,
    url: site.canonicalHost + "/",
    name: site.title,
    description: site.description,
    inLanguage: site.language,
    publisher: { "@id": operatorId },
  });
}
if (includeCanonical) schemaGraph.push(pageNode);
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph });
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, follow, noarchive" />
    <meta name="theme-color" content="#090b0b" />
    {includeCanonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    {includeCanonical && <script is:inline type="application/ld+json" set:html={structuredData} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main-content"><slot /></main>
      <SiteFooter />
    </div>
    <script is:inline src="/reveal.js" defer></script>
  </body>
</html>
