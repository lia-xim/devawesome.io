---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site } from "../data/site";
import "../styles/modern.css";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  includeCanonical?: boolean;
  language?: string;
}

const { title = site.title, description = site.description, canonicalPath, includeCanonical = true, language = site.language } = Astro.props;
const pageTitle = title === site.title ? title : `${title} | ${site.title}`;
const requestedCanonicalPath = canonicalPath ?? Astro.url.pathname;
const normalizedCanonicalPath = canonicalPath || requestedCanonicalPath === "/"
  ? requestedCanonicalPath
  : requestedCanonicalPath.replace(/\/$/, "");
const canonicalUrl = new URL(normalizedCanonicalPath, site.canonicalHost);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow, noarchive" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#090b0b" />
    {includeCanonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <SiteHeader />
      <main id="main-content"><slot /></main>
      <SiteFooter />
    </div>
    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const motion = gsap.matchMedia();
      motion.add("(prefers-reduced-motion: no-preference)", () => {
        if (document.querySelector("[data-hero-line]")) {
          const heroTimeline = gsap.timeline({ defaults: { ease: "power3.out" } });
          heroTimeline
            .from("[data-hero-kicker]", { y: 16, autoAlpha: 0, duration: 0.5 })
            .from("[data-hero-line]", { yPercent: 105, duration: 0.85, stagger: 0.08 }, "-=0.25")
            .from("[data-hero-copy]", { y: 22, autoAlpha: 0, duration: 0.65 }, "-=0.45")
            .from("[data-hero-action]", { y: 16, autoAlpha: 0, duration: 0.45, stagger: 0.08 }, "-=0.35")
            .from("[data-rig-panel]", { x: 42, autoAlpha: 0, duration: 0.75 }, "-=0.8");
        }

        document.querySelectorAll<SVGPathElement>("[data-draw-path]").forEach((path) => {
          const length = path.getTotalLength();
          gsap.set(path, { strokeDasharray: length, strokeDashoffset: length });
          gsap.to(path, {
            strokeDashoffset: 0,
            duration: 1.35,
            ease: "power2.inOut",
            scrollTrigger: { trigger: path.closest("section") ?? path, start: "top 78%", once: true },
          });
        });

        gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((element) => {
          gsap.from(element, {
            y: 34,
            autoAlpha: 0,
            duration: 0.7,
            ease: "power3.out",
            scrollTrigger: { trigger: element, start: "top 86%", once: true },
          });
        });

        gsap.utils.toArray<HTMLElement>("[data-stagger]").forEach((group) => {
          gsap.from(group.children, {
            y: 24,
            autoAlpha: 0,
            duration: 0.55,
            stagger: 0.09,
            ease: "power3.out",
            scrollTrigger: { trigger: group, start: "top 82%", once: true },
          });
        });

        return () => ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
      });
    </script>
  </body>
</html>
