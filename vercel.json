{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "permanent": true,
      "destination": "/guess-the-programming-language/",
      "source": "/quiz"
    },
    {
      "permanent": true,
      "destination": "/guess-the-programming-language/",
      "source": "/guess-the-programming-language"
    },
    {
      "permanent": true,
      "destination": "/field-tests",
      "source": "/field-tests/"
    },
    {
      "permanent": true,
      "destination": "/field-tests/astro-static-route-contract",
      "source": "/field-tests/astro-static-route-contract/"
    },
    {
      "permanent": true,
      "destination": "/field-tests/pnpm-frozen-lockfile-contract",
      "source": "/field-tests/pnpm-frozen-lockfile-contract/"
    },
    {
      "permanent": true,
      "destination": "/field-tests/evidence-receipt-contract",
      "source": "/field-tests/evidence-receipt-contract/"
    },
    {
      "permanent": true,
      "destination": "/guides",
      "source": "/guides/"
    },
    {
      "permanent": true,
      "destination": "/guides/reproducible-developer-tool-tests",
      "source": "/guides/reproducible-developer-tool-tests/"
    },
    {
      "permanent": true,
      "destination": "/tools/developer-tool-test-plan",
      "source": "/tools/developer-tool-test-plan/"
    },
    {
      "permanent": true,
      "destination": "/tools",
      "source": "/tools/"
    },
    {
      "permanent": true,
      "destination": "/tools/keyword-list-cleaner",
      "source": "/tools/keyword-list-cleaner/"
    },
    {
      "permanent": true,
      "destination": "/tools/url-list-normalizer",
      "source": "/tools/url-list-normalizer/"
    },
    {
      "permanent": true,
      "destination": "/tools/robots-txt-tester",
      "source": "/tools/robots-txt-tester/"
    },
    {
      "permanent": true,
      "destination": "/tools/serp-snippet-preview",
      "source": "/tools/serp-snippet-preview/"
    },
    {
      "permanent": true,
      "destination": "/tools/mcp-json-rpc-validator",
      "source": "/tools/mcp-json-rpc-validator/"
    },
    {
      "permanent": true,
      "destination": "/tools/json-formatter",
      "source": "/tools/json-formatter/"
    },
    {
      "permanent": true,
      "destination": "/tools/uuid-generator",
      "source": "/tools/uuid-generator/"
    },
    {
      "permanent": true,
      "destination": "/tools/evidence-receipt",
      "source": "/tools/evidence-receipt/"
    },
    {
      "permanent": true,
      "destination": "/labs",
      "source": "/labs/"
    },
    {
      "permanent": true,
      "destination": "/methodology",
      "source": "/methodology/"
    },
    {
      "permanent": true,
      "destination": "/new-ownership",
      "source": "/new-ownership/"
    },
    {
      "permanent": true,
      "destination": "/archive/14",
      "source": "/archive/14/"
    },
    {
      "permanent": true,
      "destination": "/archive/49",
      "source": "/archive/49/"
    },
    {
      "permanent": true,
      "destination": "/impressum",
      "source": "/impressum/"
    },
    {
      "permanent": true,
      "destination": "/datenschutz",
      "source": "/datenschutz/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://analytics.contextter.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://analytics.contextter.com; manifest-src 'self'; worker-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
