{
  "name": "devawesome-io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Project foundation for a low-cadence developer field-test lab under new ownership.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "field-test:astro": "node scripts/field-tests/astro-static-contract.mjs",
    "field-test:astro:capture": "node scripts/field-tests/astro-static-contract.mjs --capture",
    "field-test:pnpm": "node scripts/field-tests/pnpm-frozen-lockfile.mjs",
    "field-test:pnpm:capture": "node scripts/field-tests/pnpm-frozen-lockfile.mjs --capture",
    "verify": "pnpm build && pnpm field-test:astro && pnpm field-test:pnpm && pnpm qa"
  },
  "dependencies": {
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.2"
}
